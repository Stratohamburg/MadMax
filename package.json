{
  "name": "madmax-driving-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "physics:benchmark": "node --import ./scripts/physics-loader.mjs scripts/physics-benchmark.ts",
    "physics:audit": "node --import ./scripts/physics-loader.mjs scripts/physics-audit.ts",
    "validation:replay": "node --import ./scripts/physics-loader.mjs scripts/vehicle-web-replay.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
